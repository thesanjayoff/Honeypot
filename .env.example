# Copy to .env (deploy/deploy.sh does this for you) and edit. Never commit .env.
# Values with a dollar sign (the password hash) must stay in single quotes.

# ---- where state lives on the VPS --------------------------------------------------------------
HONEYNET_DATA=/srv/honeynet

# ---- YOU: the real admin access (everything here is excluded from logs, exports and the blocklist) --
# Your real sshd moves to this port; the honeypot takes port 22.
ADMIN_SSH_PORT=22022
# Comma-separated list of your own addresses/CIDRs. Strongly recommended: the firewall then only lets
# these reach the admin SSH port, and none of their traffic is ever recorded.
ADMIN_IPS=

# ---- dashboard (private: published on 127.0.0.1 only, reach it through an SSH tunnel) --------------------
# Create with:  docker run --rm -it honeynet/dashboard:local hash-password
HONEYNET_DASHBOARD_PASSWORD_HASH=''
DASHBOARD_PORT=8088
# Optional: where this server physically is (decimal degrees). The map then draws attack arcs into it. Leave empty to hide.
HONEYNET_HOME_LAT=
HONEYNET_HOME_LON=

# ---- host ports the honeypots listen on (container ports stay unprivileged) ---------------------------
SSH_HOST_PORT=22
TELNET_HOST_PORT=23
HTTP_HOST_PORT=80
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

# ---- optional enrichment (all off by default; only hashes / IPs are ever sent, never files) ------------
# Offline GeoLite2 City + ASN .mmdb files go in ./geoip (mounted read-only). Free account at maxmind.com.
HONEYNET_ABUSEIPDB_ENABLED=0
HONEYNET_ABUSEIPDB_KEY=
HONEYNET_BAZAAR_ENABLED=0
HONEYNET_BAZAAR_KEY=

# ---- optional alerts ----------------------------------------------------------------------------------
HONEYNET_WEBHOOK_URL=
HONEYNET_SMTP_HOST=
HONEYNET_SMTP_PORT=587
HONEYNET_SMTP_USER=
HONEYNET_SMTP_PASSWORD=
HONEYNET_SMTP_FROM=
HONEYNET_SMTP_TO=

# ---- outbound traffic ---------------------------------------------------------------------------------
# Honeypot containers get NO internet. These switches open narrow, rate-limited holes in the firewall.
# 1 = run the sandboxed "fetcher" so attacker download URLs are really fetched (stored, never executed).
ENABLE_FETCHER=0
# Set to http://fetcher:8099 together with ENABLE_FETCHER=1 (deploy.sh does it when you answer yes).
FETCHER_URL=
HONEYNET_FETCHER_TOKEN=
# Space separated host names the dashboard may reach on tcp/443 (AbuseIPDB, MalwareBazaar, your webhook, SMTP host:port needs EXTRA).
DASHBOARD_EGRESS_HOSTS=
# TCP ports allowed to those hosts (443 for the APIs; add 587 if you use SMTP alerts).
DASHBOARD_EGRESS_PORTS=443
